<UserControl x:Class="ClientOPreview.Views.HotkeysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:ClientOPreview.Localization"
             mc:Ignorable="d">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Text="{loc:Tr HotkeysTitle}" FontWeight="SemiBold" Margin="0,0,0,10"/>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="220"/>
      </Grid.ColumnDefinitions>

      <!-- Left side: Hotkey settings -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
        <StackPanel>
          <!-- Enable/Disable -->
          <CheckBox x:Name="ChkEnabled" Content="{loc:Tr HotkeysEnable}" Margin="0,0,0,16" Checked="OnEnabledChanged" Unchecked="OnEnabledChanged"/>

          <!-- Only visible when Windows refused a combo (Alt+Tab and friends). -->
          <TextBlock x:Name="TxtRegisterWarning" Foreground="#C24E00" TextWrapping="Wrap"
                     Margin="0,0,0,16" Visibility="Collapsed"/>

          <!-- Cycle Hotkey Section -->
          <TextBlock Text="{loc:Tr HotkeysCycleTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBlock Text="{loc:Tr HotkeysCycleDesc}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{loc:Tr HotkeysModifiers}" Width="100" VerticalAlignment="Center"/>
            <CheckBox x:Name="ChkCycleAlt" Content="Alt" Margin="0,0,12,0" Checked="OnCycleModifiersChanged" Unchecked="OnCycleModifiersChanged"/>
            <CheckBox x:Name="ChkCycleCtrl" Content="Ctrl" Margin="0,0,12,0" Checked="OnCycleModifiersChanged" Unchecked="OnCycleModifiersChanged"/>
            <CheckBox x:Name="ChkCycleShift" Content="Shift" Checked="OnCycleModifiersChanged" Unchecked="OnCycleModifiersChanged"/>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="{loc:Tr HotkeysKey}" Width="100" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtCycleKey" Width="120" IsReadOnly="True" PreviewKeyDown="OnCycleKeyDown"
                     GotFocus="OnKeyBoxFocus" LostFocus="OnKeyBoxLostFocus"
                     ToolTip="{loc:Tr HotkeysKeyTooltip}"/>
            <TextBlock Text="{loc:Tr HotkeysKeyHint}" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>

          <Separator Margin="0,0,0,16"/>

          <!-- Direct Hotkeys Section -->
          <TextBlock Text="{loc:Tr HotkeysDirectTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBlock Text="{loc:Tr HotkeysDirectDesc}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="{loc:Tr HotkeysModifiers}" Width="100" VerticalAlignment="Center"/>
            <CheckBox x:Name="ChkDirectAlt" Content="Alt" Margin="0,0,12,0" Checked="OnDirectModifiersChanged" Unchecked="OnDirectModifiersChanged"/>
            <CheckBox x:Name="ChkDirectCtrl" Content="Ctrl" Margin="0,0,12,0" Checked="OnDirectModifiersChanged" Unchecked="OnDirectModifiersChanged"/>
            <CheckBox x:Name="ChkDirectShift" Content="Shift" Checked="OnDirectModifiersChanged" Unchecked="OnDirectModifiersChanged"/>
          </StackPanel>

          <TextBlock Text="{loc:Tr HotkeysMappings}" Margin="0,0,0,8"/>

          <ItemsControl x:Name="DirectKeysList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Text="{Binding Label}" Width="100" VerticalAlignment="Center"/>
                  <TextBox Width="80" Text="{Binding Key}" IsReadOnly="True"
                           PreviewKeyDown="OnDirectKeyDown" Tag="{Binding Index}"
                           GotFocus="OnKeyBoxFocus" LostFocus="OnKeyBoxLostFocus"
                           Margin="0,0,8,0"/>
                  <TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <ComboBox Width="180" Tag="{Binding Index}"
                            ItemsSource="{Binding AvailableThumbnails}"
                            SelectedItem="{Binding SelectedThumbnail}"
                            SelectionChanged="OnThumbnailSelectionChanged"
                            DisplayMemberPath="Title"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </ScrollViewer>

      <!-- Right side: Open thumbnails list -->
      <Border Grid.Column="1" BorderBrush="#ccc" BorderThickness="1" Padding="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Text="{loc:Tr HotkeysOpenThumbnails}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtReorderHint" Text="{loc:Tr HotkeysReorderHint}" Foreground="Gray"
                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
          </StackPanel>

          <ListBox x:Name="OpenThumbnailsList" Grid.Row="1"
                   BorderThickness="0" Background="Transparent"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   AllowDrop="True"
                   PreviewMouseLeftButtonDown="OnOrderMouseDown"
                   PreviewMouseMove="OnOrderMouseMove"
                   DragOver="OnOrderDragOver"
                   Drop="OnOrderDrop">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="2"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="SizeNS"/>
                <!-- The drop line: a top border that only the item under the cursor shows. -->
                <Setter Property="BorderBrush" Value="#1E88E5"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter Property="BorderThickness" Value="0,2,0,0"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" ToolTip="{Binding Title}">
                  <TextBlock Text="⋮⋮" Foreground="#999" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Index}" Width="20" FontWeight="Bold" Foreground="#666"/>
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock x:Name="TxtNoThumbnails" Grid.Row="1" Text="{loc:Tr HotkeysNoThumbnails}"
                     Foreground="Gray" FontStyle="Italic"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="Collapsed"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
