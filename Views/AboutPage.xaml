<UserControl x:Class="ClientOPreview.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClientOPreview.Localization">
  <StackPanel Margin="12">
    <TextBlock Text="{loc:Tr AboutTitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock x:Name="TxtVersion" Margin="0,0,0,8"/>
    <TextBlock TextWrapping="Wrap" Text="{loc:Tr AboutDisclaimer}"/>
  </StackPanel>
</UserControl>
