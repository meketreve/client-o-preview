<UserControl x:Class="ClientOPreview.Views.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <TextBlock Text="General" FontWeight="SemiBold" Margin="10"/>
    <StackPanel Grid.Row="1" Margin="10">
      <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize to System Tray" Checked="OnChanged" Unchecked="OnChanged"/>
      <CheckBox x:Name="ChkTrackLocations" Content="Track client locations" Checked="OnChanged" Unchecked="OnChanged"/>
      <CheckBox x:Name="ChkTopmost" Content="Previews always on top" Margin="0,6,0,0" IsChecked="True" Checked="OnChanged" Unchecked="OnChanged"/>
      <CheckBox x:Name="ChkUniqueLayout" Content="Save individual window positions" Checked="OnChanged" Unchecked="OnChanged"/>
      
      <Separator Margin="0,10"/>
      <CheckBox x:Name="ChkSnapToGrid" Content="Snap to grid during move" Checked="OnChanged" Unchecked="OnChanged"/>
      <StackPanel Margin="20,5,0,0">
        <TextBlock Text="Grid Size:"/>
        <DockPanel>
          <TextBlock Text="{Binding Value, ElementName=SliderGridSize}" DockPanel.Dock="Right" Width="30" TextAlignment="Right"/>
          <Slider x:Name="SliderGridSize" Minimum="5" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnChanged"/>
        </DockPanel>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
