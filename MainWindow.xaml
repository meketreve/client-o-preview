<Window x:Class="ClientOPreview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClientOPreview.Localization"
        Title="client-o-preview" Height="520" Width="820">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Sidebar -->
        <StackPanel Grid.Column="0" Margin="8">
            <Button Content="{loc:Tr NavThumbnail}" Margin="0,0,0,6" Click="Nav_Thumbnail"/>
            <Button Content="{loc:Tr NavHotkeys}" Margin="0,0,0,6" Click="Nav_Hotkeys"/>
            <Button Content="{loc:Tr NavZoom}" Margin="0,0,0,6" Click="Nav_Zoom"/>
            <Button Content="{loc:Tr NavRegion}" Margin="0,0,0,6" Click="Nav_Region"/>
            <Button Content="{loc:Tr NavClients}" Margin="0,0,0,6" Click="Nav_Clients"/>
            <Button Content="{loc:Tr NavLanguage}" Margin="0,0,0,6" Click="Nav_Language"/>
            <Button Content="{loc:Tr NavAbout}" Margin="0,0,0,6" Click="Nav_About"/>
        </StackPanel>
        <!-- Content area -->
        <Border Grid.Column="1" Margin="8" BorderBrush="#ddd" BorderThickness="1">
            <ContentControl x:Name="ContentHost"/>
        </Border>
    </Grid>
</Window>
