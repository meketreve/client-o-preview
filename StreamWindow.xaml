<Window x:Class="ClientOPreview.StreamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stream" Height="320" Width="520"
        Background="#101010"
        AllowsTransparency="False"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <DockPanel LastChildFill="True">
        <Border x:Name="TitleBar" DockPanel.Dock="Top" Background="#202020" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <DockPanel Margin="6,4">
                <Button x:Name="BtnRegion" DockPanel.Dock="Right" Content="▣" Width="20" Height="18" Padding="0"
                        Background="#303030" Foreground="#d0d0d0" BorderThickness="0" FontSize="11"
                        Click="BtnRegion_Click" ToolTip="Focus a region of this window"/>
                <TextBlock x:Name="TxtRegion" DockPanel.Dock="Right" Foreground="#4FC3F7" VerticalAlignment="Center"
                           FontSize="11" Margin="6,0" Visibility="Collapsed" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                <TextBlock x:Name="TxtTitle" Foreground="#d0d0d0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <Grid x:Name="ContentGrid" MouseLeftButtonDown="Content_MouseLeftButtonDown" MouseRightButtonDown="Window_MouseRightButtonDown" Background="Transparent">
            <!-- O DWM Thumbnail preencherá esta área -->
        </Grid>
    </DockPanel>
</Window>
