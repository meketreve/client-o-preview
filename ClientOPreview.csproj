<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Single source of truth for the version: the About page reads it from the assembly. -->
    <Version>0.9.0</Version>
    <!-- requireAdministrator: focusing an elevated game client needs equal integrity (bug-008). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- tests/ and linux/ are their own projects; keep them out of the app's default globbing. -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <!-- linux/ is the Avalonia/X11 build, its own project. -->
    <Compile Remove="linux/**" />
    <None Remove="linux/**" />
  </ItemGroup>
</Project>
