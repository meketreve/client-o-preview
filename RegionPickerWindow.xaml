<Window x:Class="ClientOPreview.RegionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClientOPreview.Localization"
        Title="{loc:Tr PickerTitle}" Height="640" Width="1000" MinHeight="480" MinWidth="760"
        Background="#141414" WindowStartupLocation="CenterScreen" Topmost="True"
        Loaded="Window_Loaded" SizeChanged="Window_SizeChanged" StateChanged="Window_StateChanged"
        Closed="Window_Closed">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TxtSource" Grid.Row="0" Foreground="#d0d0d0" FontWeight="SemiBold" Margin="0,0,0,6"
                       TextTrimming="CharacterEllipsis"/>
            <Border x:Name="PreviewHost" Grid.Row="1" Background="Black" BorderBrush="#333" BorderThickness="1"/>
        </Grid>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,10,10,10">
            <StackPanel>
                <TextBlock Text="{loc:Tr PickerPresetName}" Foreground="#dddddd" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtName" Height="24"/>
                <TextBlock Text="{loc:Tr PickerNameTip}"
                           Foreground="#777777" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12"/>

                <TextBlock Text="{loc:Tr PickerQuickAnchors}" Foreground="#dddddd" Margin="0,0,0,4"/>
                <UniformGrid Rows="3" Columns="3" Height="96" Margin="0,0,0,6">
                    <Button Tag="0,0" Content="◤" Margin="1" Click="OnQuickAnchor"/>
                    <Button Tag="1,0" Content="▲" Margin="1" Click="OnQuickAnchor"/>
                    <Button Tag="2,0" Content="◥" Margin="1" Click="OnQuickAnchor"/>
                    <Button Tag="0,1" Content="◀" Margin="1" Click="OnQuickAnchor"/>
                    <Button Tag="1,1" Content="●" Margin="1" Click="OnQuickAnchor"/>
                    <Button Tag="2,1" Content="▶" Margin="1" Click="OnQuickAnchor"/>
                    <Button Tag="0,2" Content="◣" Margin="1" Click="OnQuickAnchor"/>
                    <Button Tag="1,2" Content="▼" Margin="1" Click="OnQuickAnchor"/>
                    <Button Tag="2,2" Content="◢" Margin="1" Click="OnQuickAnchor"/>
                </UniformGrid>

                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="{Binding Value, ElementName=SliderAnchorSize, StringFormat={}{0:P0}}"
                               DockPanel.Dock="Right" Width="42" TextAlignment="Right" Foreground="#aaaaaa"/>
                    <TextBlock Text="{loc:Tr PickerAnchorSize}" Foreground="#dddddd"/>
                </DockPanel>
                <Slider x:Name="SliderAnchorSize" Minimum="0.10" Maximum="0.80" Value="0.33"
                        TickFrequency="0.01" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>

                <Button Content="{loc:Tr PickerFullWindow}" Height="26" Margin="0,0,0,12" Click="OnFullWindow"/>

                <TextBlock Text="{loc:Tr PickerResult}" Foreground="#dddddd" Margin="0,0,0,4"/>
                <Border x:Name="ResultHost" Height="130" Background="Black" BorderBrush="#333" BorderThickness="1"
                        Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtReadout" Foreground="#888888" FontSize="11" Margin="0,0,0,12"/>

                <CheckBox x:Name="ChkLockAspect" Content="{loc:Tr PickerLockAspect}" IsChecked="True"
                          Foreground="#dddddd" Margin="0,0,0,6"/>
                <CheckBox x:Name="ChkFitWindow" Content="{loc:Tr PickerFitWindow}" IsChecked="True"
                          Foreground="#dddddd" Margin="0,0,0,14"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="{loc:Tr PickerSave}" Width="90" Height="28" Margin="0,0,8,0" Click="OnSave" IsDefault="True"/>
                    <Button Content="{loc:Tr PickerCancel}" Width="90" Height="28" Click="OnCancel" IsCancel="True"/>
                </StackPanel>

                <TextBlock Text="{loc:Tr PickerHint}"
                           Foreground="#777777" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
